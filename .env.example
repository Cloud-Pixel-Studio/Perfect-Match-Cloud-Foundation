# Store real values in a protected file outside the repository.
POSTGRES_DB=pmcloud_dev
POSTGRES_USER=pmcloud_dev
POSTGRES_PASSWORD=<local-development-password>
POSTGRES_MIGRATION_USER=pmcloud_migrator
POSTGRES_MIGRATION_PASSWORD=<local-development-password>
POSTGRES_RUNTIME_USER=pmcloud_app
POSTGRES_RUNTIME_PASSWORD=<local-development-password>
KEYCLOAK_ADMIN=pmcloud-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=<local-development-password>
KEYCLOAK_USER_A_PASSWORD=<synthetic-local-password>
KEYCLOAK_USER_B_PASSWORD=<synthetic-local-password>
KEYCLOAK_MULTI_USER_PASSWORD=<synthetic-local-password>
OIDC_CLIENT_ID=perfect-match-web
OIDC_ISSUER=http://127.0.0.1:8080/realms/perfect-match
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/perfect-match/.well-known/openid-configuration
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CALLBACK_URL=http://127.0.0.1:8000/auth/callback
PMC_LOGIN_TRANSACTION_KEY=<local-fernet-key>
PMC_COOKIE_SECURE=false
PMC_ENVIRONMENT=development
PMC_WEB_URL=http://127.0.0.1:3000
SEAWEEDFS_ACCESS_KEY=<local-development-access-key>
SEAWEEDFS_SECRET_KEY=<local-development-secret-key>
SEAWEEDFS_SIGNING_KEY=<local-development-signing-key>
PMC_RUNTIME_DIR=<absolute-local-runtime-directory>
APP_VERSION=0.3.0
WEB_BUILD_TARGET=runtime
